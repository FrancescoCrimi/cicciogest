<?xml version="1.0" encoding="utf-8"?>
<hibernate-mapping assembly="Domain"
									 namespace="CiccioGest.Domain.Anagrafica"
									 xmlns="urn:nhibernate-mapping-2.2">

	<class name="Comune" table="Comuni">

		<id name="Id" generator="identity" unsaved-value="0" />
		<property name="Nome" not-null="true" index="IX_Comune_Nome" />
		<property name="Provincia" not-null="true" index="IX_Comune_Provincia" />

		<bag name="Caps" table="ComuniCaps" batch-size="999" cascade="all-delete-orphan">
			<key column="IdComune" foreign-key="FK_ComuniCaps_Comune" />
			<element column="Cap" not-null="true" />
		</bag>

		<many-to-one name="Nazione" class="Nazione" cascade="all" fetch="join" foreign-key="FK_Comuni_Nazioni" >
			<column name="IdNazione" not-null="true" index="IX_Comune_IdNazione" />
		</many-to-one>

	</class>

</hibernate-mapping>
