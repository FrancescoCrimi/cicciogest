<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="CiccioGest.Presentation.WinUiBackend.Views.ArticoliView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CiccioGest.Presentation.WinUiBackend.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="using:Microsoft.Xaml.Interactivity"
             xmlns:b="using:CommunityToolkit.WinUI.Behaviors"
             xmlns:uc="using:CiccioGest.Presentation.WinUiBackend.UserControls"
             xmlns:viewmodel="using:CiccioGest.Presentation.Mvvm.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewmodel:ArticoliViewModel}"
             Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <i:Interaction.Behaviors>
        <i:EventTriggerBehavior EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand, Mode=OneWay}" />
        </i:EventTriggerBehavior>
    </i:Interaction.Behaviors>

    <Grid Margin="{StaticResource SmallLeftRightMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <RelativePanel Grid.Row="0">

            <TextBlock x:Name="PageTitle"
                       Text="Articoli"
                       Margin="{StaticResource SmallLeftMargin}"
                       Style="{StaticResource PageTitleStyle}" />

            <CommandBar x:Name="mainCommandBar"
                        DefaultLabelPosition="Right"
                        HorizontalAlignment="Stretch"
                        Background="Transparent"
                        RelativePanel.LeftOf="OrderSearchBox"
                        RelativePanel.RightOf="PageTitle">
                <AppBarButton Icon="Refresh"
                              Label="Aggiorna"
                              Command="{Binding AggiornaCommand}" />
                <AppBarButton Icon="Accept"
                              Label="Conferma"
                              Command="{Binding ConfermaCommand}" />
                <AppBarButton Icon="Cancel"
                              Label="Annulla"
                              Command="{Binding AnnullaCommand}" />
            </CommandBar>

            <uc:CollapsibleSearchBox x:Name="OrderSearchBox"
                                     Width="240"
                                     Margin="12,8,12,0"
                                     CollapseWidth="{StaticResource MediumWindowSnapPoint}"
                                     RelativePanel.AlignRightWithPanel="True" />

        </RelativePanel>

        <!--<uc:ListaArticoliControl Grid.Row="1" />-->

        <!--<tollkit:DataGrid CanUserReorderColumns="False"
                              CanUserResizeColumns="False"
                              AutoGenerateColumns="False"
                              GridLinesVisibility="Horizontal"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              ItemsSource="{Binding Articoli, Mode=OneWay}"
                              SelectedItem="{Binding ArticoloSelezionato, Mode=TwoWay}">
                <tollkit:DataGrid.Columns>
                    <tollkit:DataGridTextColumn Header="Invoice"
                                                Tag="InvoiceNumber"
                                                Binding="{Binding Id}" />
                    <tollkit:DataGridTextColumn Header="Customer"
                                                Tag="CustomerName"
                                                Binding="{Binding Nome}" />
                    <controls:DataGridTextColumn Header="Totale"
                                                 Tag="TotaleName"
                                                 Binding="{Binding Totale}" />
                </tollkit:DataGrid.Columns>
            </tollkit:DataGrid>-->

        <ListView Grid.Row="1"
                  ItemsSource="{Binding Articoli, Mode=OneWay}"
                  SelectedItem="{Binding ArticoloSelezionato, Mode=TwoWay}">
            <ListView.Resources>
                <ResourceDictionary Source="ms-appx:///WinUiBackend/Themes/ListViewItemResource.xaml" />
            </ListView.Resources>

            <i:Interaction.Behaviors>
                <i:EventTriggerBehavior EventName="DoubleTapped">
                    <i:InvokeCommandAction Command="{Binding ConfermaCommand, Mode=OneWay}" />
                </i:EventTriggerBehavior>
            </i:Interaction.Behaviors>

            <ListView.Header>
                <Grid Padding="16,0,12,0"
                      MinHeight="{ThemeResource ListViewItemMinHeight}"
                      MinWidth="{ThemeResource ListViewItemMinWidth}"
                      Background="{ThemeResource SystemChromeHighColor}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition MinWidth="90" />
                        <ColumnDefinition MinWidth="120" />
                        <ColumnDefinition MinWidth="80" />
                    </Grid.ColumnDefinitions>
                    <i:Interaction.Behaviors>
                        <b:StickyHeaderBehavior />
                    </i:Interaction.Behaviors>
                    <TextBlock Grid.Column="0"
                               Text="Invoice"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               Text="Customer"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="2"
                               Text="Totale"
                               VerticalAlignment="Center" />
                </Grid>
            </ListView.Header>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="90" />
                            <ColumnDefinition MinWidth="120" />
                            <ColumnDefinition MinWidth="80" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Id}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Nome}" />
                        <TextBlock Grid.Column="2"
                                   Text="{Binding Totale}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>



    </Grid>

</UserControl>
