<?xml version="1.0" encoding="utf-8"?>
<windowex:WindowEx x:Class="CiccioGest.Presentation.WinUiMenu.Views.MainView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:local="using:CiccioGest.Presentation.WinUiMenu.Views"
                   xmlns:suca="using:CiccioGest.Presentation.WinUiMenu"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:windowex="using:WinUIEx"
                   mc:Ignorable="d"
                   Title="MainView">

    <windowex:WindowEx.SystemBackdrop>
        <MicaBackdrop />
    </windowex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <MenuBar>
            <MenuBarItem Title="Home">
                <MenuFlyoutItem Text="Apri Dashboard"
                                Command="{Binding ApriDashboardCommand, Mode=OneWay}" />
                <MenuFlyoutItem Text="Impostazioni"
                                Command="{Binding ApriSettingsCommand, Mode=OneWay}" />
            </MenuBarItem>
            <MenuBarItem Title="Fatture">
                <MenuFlyoutItem Text="Apri Fattura"
                                Command="{Binding ApriFatturaCommand, Mode=OneWay}" />
                <MenuFlyoutItem Text="Nuova Fattura"
                                Command="{Binding NuovaFatturaCommand, Mode=OneWay}" />
            </MenuBarItem>
            <MenuBarItem Title="Magazino">
                <MenuFlyoutItem Text="Articoli"
                                Command="{Binding ApriArticoliCommand, Mode=OneWay}" />
                <MenuFlyoutItem Text="Categorie"
                                Command="{Binding ApriCategorieCommand, Mode=OneWay}" />
            </MenuBarItem>
            <MenuBarItem Title="Anagrafica">
                <MenuFlyoutItem Text="Clienti"
                                Command="{Binding ApriClientiCommand, Mode=OneWay}" />
                <MenuFlyoutItem Text="Fornitori"
                                Command="{Binding ApriFornitoriCommand, Mode=OneWay}" />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem Text="About" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1">
            <ContentControl Content="{Binding CurrentViewModel, Mode=OneWay}"
                            ContentTemplateSelector="{StaticResource VmSelector}" />
        </Grid>
    </Grid>

</windowex:WindowEx>
